#!/usr/bin/env bash
# split_pdf - Wrapper bash para executar o split_pdf.py garantindo ambiente virtual e dependências
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"

# Cria ambiente virtual se não existir
if [ ! -d "$VENV_DIR" ]; then
    echo "[split_pdf] Criando ambiente virtual em $VENV_DIR..."
    python3 -m venv "$VENV_DIR"
fi

# Instala dependências se necessário
if ! "$VENV_DIR/bin/python3" -c "import pypdf" 2>/dev/null; then
    echo "[split_pdf] Instalando pypdf..."
    "$VENV_DIR/bin/pip" install --quiet -r "$SCRIPT_DIR/requirements.txt"
fi

# Executa o script python com todos os parâmetros passados
exec "$VENV_DIR/bin/python3" "$SCRIPT_DIR/split_pdf.py" "$@"
